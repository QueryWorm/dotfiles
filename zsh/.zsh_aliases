alias gs='git status'
alias ..='cd ..'
alias ...='cd ../..'
alias c='clear'
alias wi.bess='sudo stdbuf -oL besside-ng wlan0 | grep "Pwned network"'
alias wi.hex='sudo hcxdumptool -i wlan0 -w hcx.pcapng -F -t 120 --rds=1'
alias cap.hcx='hcxpcapngtool hcx.pcapng -o out.hc22000 && hcxhashtool --info=stdout -i out.hc22000'
alias ocq='opencode --pure'
