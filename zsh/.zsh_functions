lf() {
    printf '  %s\n' *"$1"
}

setip () {
    if [ -z "$1" ]; then
        echo "usage: setip <ip>"
        return
    fi
    echo "export IP=$1" > ~/.session_vars
    source ~/.session_vars
}

getip () {
    echo $IP
}
